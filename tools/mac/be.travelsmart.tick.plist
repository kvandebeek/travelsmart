<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>be.travelsmart.tick</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>__HOME__/.travelsmart/travelsmart-tick.sh</string>
  </array>
  <!-- Every 5 minutes; the script itself only acts on weekdays 05:00-17:59 Brussels time. -->
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/travelsmart-tick.err</string>
</dict>
</plist>
